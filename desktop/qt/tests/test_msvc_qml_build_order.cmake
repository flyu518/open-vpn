cmake_minimum_required(VERSION 3.21)

if(NOT DEFINED QT_BUILD_DIR)
    message(FATAL_ERROR "QT_BUILD_DIR is required")
endif()
set(project "${QT_BUILD_DIR}/openvpn_qt_qmltyperegistration.vcxproj")
if(NOT EXISTS "${project}")
    message(FATAL_ERROR "Visual Studio QML registration project is missing: ${project}")
endif()
file(READ "${project}" project_xml)
if(NOT project_xml MATCHES "<ProjectReference Include=\"[^\"]*[/\\\\]openvpn_qt\\.vcxproj\"")
    message(FATAL_ERROR "The separate QML registration target must wait for the application target, which owns moc --collect-json; waiting for AUTOMOC extraction alone still leaves an empty metatypes file")
endif()
message(STATUS "Visual Studio QML registration waits for the target that owns metadata collection")

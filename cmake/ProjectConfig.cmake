cmake_minimum_required(VERSION 3.21)

# One parser for core, Qt and both native packaging scripts. This configuration
# is trusted source input at build time, never a writable runtime policy file.
set(_openvpn_config_module_dir "${CMAKE_CURRENT_LIST_DIR}")
get_filename_component(_openvpn_canonical_config
    "${CMAKE_CURRENT_LIST_DIR}/../project-config.json" ABSOLUTE)
if(NOT CMAKE_SCRIPT_MODE_FILE)
    if(DEFINED OPENVPN_PROJECT_CONFIG_FILE)
        get_filename_component(_openvpn_requested_config "${OPENVPN_PROJECT_CONFIG_FILE}" ABSOLUTE)
        if(NOT _openvpn_requested_config STREQUAL _openvpn_canonical_config)
            message(FATAL_ERROR "Production builds must use root project-config.json; clear OPENVPN_PROJECT_CONFIG_FILE from the cache")
        endif()
    endif()
    set(OPENVPN_PROJECT_CONFIG_FILE "${_openvpn_canonical_config}")
elseif(NOT DEFINED OPENVPN_PROJECT_CONFIG_FILE)
    set(OPENVPN_PROJECT_CONFIG_FILE "${_openvpn_canonical_config}")
endif()
if(NOT EXISTS "${OPENVPN_PROJECT_CONFIG_FILE}")
    message(FATAL_ERROR "Project configuration not found: ${OPENVPN_PROJECT_CONFIG_FILE}")
endif()
file(READ "${OPENVPN_PROJECT_CONFIG_FILE}" _openvpn_json)

function(_openvpn_read_field key expected_type output)
    string(JSON kind ERROR_VARIABLE error TYPE "${_openvpn_json}" "${key}")
    if(NOT error STREQUAL "NOTFOUND" OR NOT kind STREQUAL expected_type)
        message(FATAL_ERROR "Project configuration '${key}' must be ${expected_type}: ${error}")
    endif()
    string(JSON value GET "${_openvpn_json}" "${key}")
    set(${output} "${value}" PARENT_SCOPE)
endfunction()

_openvpn_read_field(schemaVersion NUMBER OPENVPN_CONFIG_SCHEMA)
_openvpn_read_field(version STRING OPENVPN_PROJECT_VERSION)
_openvpn_read_field(connectionTimeoutSeconds NUMBER OPENVPN_CONNECTION_TIMEOUT_SECONDS)
_openvpn_read_field(retryOnAuthFailed BOOLEAN OPENVPN_RETRY_ON_AUTH_FAILED)
if(NOT OPENVPN_CONFIG_SCHEMA STREQUAL "1")
    message(FATAL_ERROR "Unsupported project configuration schemaVersion")
endif()
if(NOT OPENVPN_PROJECT_VERSION MATCHES "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$")
    message(FATAL_ERROR "Project version must be three numeric components without leading zeros")
endif()
foreach(component IN ITEMS 1 2 3)
    if(CMAKE_MATCH_${component} GREATER 65535)
        message(FATAL_ERROR "Project version components must not exceed 65535")
    endif()
endforeach()
if(NOT OPENVPN_CONNECTION_TIMEOUT_SECONDS MATCHES "^[1-9][0-9]*$"
        OR OPENVPN_CONNECTION_TIMEOUT_SECONDS GREATER 3600)
    message(FATAL_ERROR "connectionTimeoutSeconds must be an integer from 1 to 3600")
endif()
if(OPENVPN_RETRY_ON_AUTH_FAILED)
    set(OPENVPN_RETRY_ON_AUTH_FAILED_CPP "true")
else()
    set(OPENVPN_RETRY_ON_AUTH_FAILED_CPP "false")
endif()
if(DEFINED OPENVPN_EXPECTED_VERSION AND NOT OPENVPN_EXPECTED_VERSION STREQUAL OPENVPN_PROJECT_VERSION)
    message(FATAL_ERROR "Requested version '${OPENVPN_EXPECTED_VERSION}' differs from project-config.json '${OPENVPN_PROJECT_VERSION}'")
endif()

function(openvpn_generate_config_header directory)
    file(MAKE_DIRECTORY "${directory}")
    configure_file("${_openvpn_config_module_dir}/openvpn_project_config.h.in"
        "${directory}/openvpn_project_config.h" @ONLY)
endfunction()

if(NOT CMAKE_SCRIPT_MODE_FILE)
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${OPENVPN_PROJECT_CONFIG_FILE}")
endif()
if(DEFINED OPENVPN_CONFIG_KEY)
    if(OPENVPN_CONFIG_KEY STREQUAL "version")
        set(_openvpn_value "${OPENVPN_PROJECT_VERSION}")
    elseif(OPENVPN_CONFIG_KEY STREQUAL "connectionTimeoutSeconds")
        set(_openvpn_value "${OPENVPN_CONNECTION_TIMEOUT_SECONDS}")
    elseif(OPENVPN_CONFIG_KEY STREQUAL "retryOnAuthFailed")
        set(_openvpn_value "${OPENVPN_RETRY_ON_AUTH_FAILED_CPP}")
    else()
        message(FATAL_ERROR "Unknown project configuration key: ${OPENVPN_CONFIG_KEY}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${_openvpn_value}"
        COMMAND_ERROR_IS_FATAL ANY)
endif()
